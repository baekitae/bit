# .env.example 을 .env 로 복사해서 사용하세요. .env 는 git에 올라가지 않습니다.

# AI 위원회 (3단계부터 필요). 기본 제공자: Claude
ANTHROPIC_API_KEY=

# 다른 AI 제공자를 config에서 켤 때만 필요
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# 텔레그램 알림 (선택). 둘 다 넣으면 매매·위원회 결정·오류·하루 요약을 보냄
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 업비트 키는 1~4단계에서 필요 없습니다 (공개 시세 API만 사용).
